{
  "name": "rag-ai-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next typegen && eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && effect-language-service diagnostics --project tsconfig.json --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "corpus:regions": "bun scripts/corpus/fetch-m49.ts",
    "corpus:build": "bun scripts/corpus/build-corpus.ts",
    "corpus:export-regions": "bun scripts/corpus/export-regions.ts",
    "corpus:embed": "bun scripts/corpus/embed-passages.ts",
    "evals:build": "bun scripts/evals/build-eval-set.ts",
    "evals:check": "bun scripts/evals/check-eval-set.ts",
    "evals:retrieval": "bun scripts/evals/run-retrieval.ts",
    "evals:answers": "bun scripts/evals/run-answers.ts",
    "load:steady": "bun scripts/load/steady-chat.ts",
    "load:go": "cd loadgen && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/loadgen ./cmd/loadgen && cd .. && loadgen/bin/loadgen",
    "lint:go": "cd loadgen && CGO_ENABLED=0 golangci-lint run ./... && golangci-lint fmt --diff",
    "test:go": "cd loadgen && go test -race ./...",
    "bench:pro": "bun build scripts/pro/bench-signing.ts --target=node --outfile=.next/bench-signing.mjs && node .next/bench-signing.mjs",
    "load:outage": "bun scripts/load/outage-chat.ts",
    "load:spike": "bun scripts/load/spike-chat.ts",
    "load:zipf": "bun scripts/load/zipf-chat.ts",
    "evals:assist-gate": "bun scripts/evals/run-assist-gate.ts",
    "load:search": "bun scripts/load/search-latency.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/ai-anthropic": "4.1.2",
    "@effect/ai-openai-compat": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/sql-sqlite-bun": "4.1.2",
    "@effect/sql-sqlite-node": "4.1.2",
    "@huggingface/transformers": "4.3.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "d3-geo": "3.1.2",
    "effect": "4.1.2",
    "hyparquet": "1.32.0",
    "hyparquet-compressors": "1.1.3",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.23.0",
    "topojson-client": "3.1.0",
    "tw-animate-css": "1.4.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "4.1.2",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.13",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=24"
  }
}
